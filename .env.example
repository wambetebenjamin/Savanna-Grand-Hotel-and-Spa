# Canonical deployed origin, e.g. https://www.your-domain.co.ke
NEXT_PUBLIC_SITE_URL=

# Upstash Redis (Vercel Marketplace) — distributed rate limiting + inquiry storage
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional transactional email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BOOKING_EMAIL_TO=
CONTACT_EMAIL_TO=

# Optional WhatsApp Cloud API booking alert
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=
WHATSAPP_BOOKING_TEMPLATE=booking_inquiry_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v22.0
